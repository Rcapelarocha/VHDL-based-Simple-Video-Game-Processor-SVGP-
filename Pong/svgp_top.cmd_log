par -w -intstyle ise -ol high -t 1 svgp_top_map.ncd svgp_top.ncd svgp_top.pcf 
trce -intstyle ise -v 3 -s 5 -n 3 -fastpaths -xml svgp_top.twx svgp_top.ncd -o svgp_top.twr svgp_top.pcf -ucf constraints.ucf 
bitgen -intstyle ise -f svgp_top.ut svgp_top.ncd 
